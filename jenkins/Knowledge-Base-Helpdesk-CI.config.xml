<?xml version='1.1' encoding='UTF-8'?>
<!--
  Pipeline-from-SCM definition for the EXISTING Jenkins job "Knowledge-Base-Helpdesk-CI".
  The job currently has no pipeline definition at all. Apply this with the Jenkins UI
  (see docs/Jenkins-Pipeline.md) or by POSTing it to /job/Knowledge-Base-Helpdesk-CI/config.xml.
  Change <name>*/main</name> to build another branch.
-->
<flow-definition plugin="workflow-job">
  <description>CI for Knowledge Base Helpdesk: compile, unit and integration tests, package, Selenium (Chrome in Docker), versioned Docker image, temporary deployment with health gate.</description>
  <keepDependencies>false</keepDependencies>
  <properties/>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>https://github.com/SamarthBurkul/knowledge-base-helpdesk.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
